---
import 'katex/dist/katex.min.css';
const { titel } = Astro.props;
---
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{titel} | Mechanics of Nature</title>
    <style is:global>
      :root { --bg:#fbfaf7; --tekst:#1c1c1e; --zacht:#6b6b70; --kaart:#fff; --lijn:#e6e3dc; --accent:#2f5fd0; }
      @media (prefers-color-scheme: dark) {
        :root { --bg:#0f1117; --tekst:#ececf1; --zacht:#9a9aa5; --kaart:#171a23; --lijn:#272b38; --accent:#7aa2ff; }
      }
      * { box-sizing:border-box; }
      body { margin:0; background:var(--bg); color:var(--tekst);
             font-family:Georgia,"Times New Roman",serif; line-height:1.7; font-size:1.1rem; }
      nav { max-width:46rem; margin:0 auto; padding:1.25rem 1.5rem;
            display:flex; justify-content:space-between; font-family:system-ui,sans-serif; font-size:.95rem; }
      nav a { color:var(--tekst); text-decoration:none; font-weight:600; }
      main { max-width:46rem; margin:0 auto; padding:1rem 1.5rem 5rem; }
      h1 { font-size:clamp(2rem,6vw,3rem); line-height:1.15; margin:.5rem 0 1rem; }
      h2 { margin-top:2.5rem; line-height:1.25; }
      a { color:var(--accent); }
      .label { color:var(--accent); font-family:system-ui,sans-serif; letter-spacing:.15em;
               text-transform:uppercase; font-size:.8rem; font-weight:600; }
      .sim { background:var(--kaart); border:1px solid var(--lijn); border-radius:12px;
             padding:1rem 1.25rem; font-family:system-ui,sans-serif; margin:1.5rem 0; }
      .katex-display { overflow-x:auto; overflow-y:hidden; }
      footer { max-width:46rem; margin:0 auto; padding:1.5rem; border-top:1px solid var(--lijn);
               color:var(--zacht); font-family:system-ui,sans-serif; font-size:.9rem; }
      .tekst blockquote { margin:1.5rem 0; padding:.25rem 1.25rem; border-left:4px solid var(--accent); background:var(--kaart); }
      .tekst h2 { border-bottom:1px solid var(--lijn); padding-bottom:.3rem; }
      .tekst blockquote { margin:1.5rem 0; padding:.25rem 1.25rem; border-left:4px solid var(--accent); background:var(--kaart); }
    </style>
  </head>
  <body>
    <nav><a href="/">Mechanics of Nature</a><span>Wiskunde en natuurkunde</span></nav>
    <main><slot /></main>
    <footer>Geschreven door iemand die zelf nog aan het leren is. Fouten gevonden? Laat het weten.</footer>
  </body>
</html>